{
  "project_name": "phenoleaf_lowlabel",
  "description": "Low-label temporal leaf instance segmentation",

  "data": {
    "raw_dir": "data/phenoleaf_ts/extracted/PhenoLeaf-TS_DS/01_raw_dataset",
    "mask_dir": "data/phenoleaf_ts/extracted/PhenoLeaf-TS_DS/02_leaf_labels",
    "manifest_path": "data_audit/manifest.json",
    "coco_dir": "data/phenoleaf_ts/prepared/coco",
    "yolo_dir": "data/phenoleaf_ts/prepared/yolo/standard"
  },

  "splits": {
    "split_path": "splits/plant_split.json",
    "cross_genotype_split": "splits/cross_genotype_split.json",
    "seed": 42
  },

  "model": {
    "name": "maskrcnn_resnet50_fpn",
    "num_classes": 2,
    "pretrained_backbone": true,
    "input_size": 512,
    "mixed_precision": true
  },

  "training": {
    "batch_size": 2,
    "microbatch": 1,
    "optimizer": "SGD",
    "lr": 0.0025,
    "momentum": 0.9,
    "weight_decay": 0.0001,
    "warmup_steps": 200,
    "n_epochs_teacher": 5,
    "n_epochs_student": 5,
    "eval_every": 500,
    "training_seeds": [17, 42, 2026]
  },

  "annotation": {
    "budget_ratios": [0.05, 0.10, 0.20],
    "n_val_labels_per_plant": 4,
    "val_positions": [0.2, 0.4, 0.6, 0.8]
  },

  "selection": {
    "eta": 0.2,
    "n_augmentations": 2,
    "iou_threshold": 0.5,
    "confidence_threshold": 0.8,
    "equal_weight_signals": true
  },

  "propagation": {
    "max_time_hours": 48,
    "iou_threshold": 0.7,
    "bidirectional": true,
    "consistency_check": true
  },

  "pseudo_labels": {
    "lambda_pseudo": 0.5,
    "min_confidence": 0.8,
    "min_iou": 0.7,
    "ignore_unmatched": true
  },

  "output_dir": "output",
  "log_dir": "logs",

  "pilot": {
    "n_train_plants": 40,
    "n_val_plants": 12,
    "budget_ratio": 0.10,
    "n_seeds": 2,
    "continue_threshold_ap": 1.0
  }
}
